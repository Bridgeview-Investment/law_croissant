# RegGenome API Configuration
# Option 1: Direct access token (JWT)
REGGENOME_ACCESS_TOKEN=your_access_token_here

# Option 2: Path to file containing authentication response
REGGENOME_API_FILE=../reggenome_api.md

# API Base URL
REGGENOME_API_URL=https://api.reggenome.com/api/v1

# Processing Configuration
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=60
CACHE_ENABLED=true
CACHE_DIR=./data/cache

# Model Configuration
USE_GPU=true
MODEL_BATCH_SIZE=32
CONFIDENCE_THRESHOLD=0.7

# Output Configuration
OUTPUT_DIR=./outputs
GENERATE_VISUALIZATIONS=true
EXPORT_FORMAT=json,csv,html